####################################################################
# iNWebTools — Environment Variables (TEMPLATE)
# ------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Fill in real values in .env  (NEVER commit .env to Git)
####################################################################

# ------------------------------------------------------------------
# Project
# ------------------------------------------------------------------
PROJECT_NAME=iNWebTools

# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
NODE_ENV=development
PORT=5000
HOST=0.0.0.0
LOG_LEVEL=debug

# ------------------------------------------------------------------
# Hugging Face Inference API
# Create a free token: https://huggingface.co/settings/tokens  (role: read)
# ------------------------------------------------------------------
HF_FREE_API_TOKEN=your_hugging_face_token_here

# Legacy alias, still honoured if HF_FREE_API_TOKEN is unset.
# HUGGINGFACE_API_KEY=

# ASR model, fixed per deployment (the client cannot override it).
#   openai/whisper-large-v3       -> default. Reliable script detection across
#                                    all 99 languages, including Bengali.
#   openai/whisper-large-v3-turbo -> ~2-4x faster, but its pruned decoder can
#                                    fall into repetition loops and emit the
#                                    wrong script on low-resource languages.
#                                    Safe only if your audio is high-resource
#                                    (English, Chinese, Spanish, French, ...).
#   openai/whisper-small          -> lightweight / cheap testing
HF_MODEL=openai/whisper-large-v3

# Inference behaviour
# Base URL for hosted inference. The legacy api-inference.huggingface.co host
# was retired; hosted Whisper now lives behind the hf-inference provider.
HF_API_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_REQUEST_TIMEOUT_MS=180000
HF_MAX_RETRIES=3
HF_RETRY_BASE_DELAY_MS=2000

# ------------------------------------------------------------------
# Uploads
# ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/x-wav,audio/webm,audio/ogg,audio/flac,audio/mp4,audio/x-m4a
UPLOAD_TMP_DIR=./tmp

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------------
# Frontend (Vite) — only VITE_* prefixed vars reach the browser bundle
# ------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_DEFAULT_LOCALE=bn
VITE_MAX_UPLOAD_SIZE_MB=25
