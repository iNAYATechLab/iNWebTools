####################################################################
# iNWebTools — API Server environment (TEMPLATE)
# ------------------------------------------------------------------
# 1. Copy this file:   cp .env.example .env
# 2. Fill in real values in .env  (NEVER commit .env to Git)
####################################################################

# ------------------------------------------------------------------
# Project
# ------------------------------------------------------------------
PROJECT_NAME="iNWebTools"

# ------------------------------------------------------------------
# Runtime
# ------------------------------------------------------------------
PORT=5000
HOST=0.0.0.0

# Reverse-proxy awareness for rate limiting.
# SECURITY: leave as false when the server is exposed directly. Any client can
# forge X-Forwarded-For, so trusting it without a proxy in front lets attackers
# rotate fake IPs and bypass the rate limiter entirely.
#   false  = trust nobody (default, safest)
#   1      = exactly one proxy in front (nginx / Render / Railway / Heroku)
#   <ips>  = comma-separated trusted proxy IPs or subnets
# Number of proxy hops in front of this server, or false when there are none.
# Rate limiting keys on the client IP, so behind a proxy every caller looks
# like the proxy and one visitor's attempts throttle everyone.
#   - local development through the Vite proxy: 1
#   - direct, no proxy: false
#   - behind nginx/Cloudflare: the real hop count
# Never set `true` on a public server: X-Forwarded-For is caller-supplied, and
# trusting it blindly lets an attacker rotate the header past any limiter.
TRUST_PROXY=1
NODE_ENV=development

# ------------------------------------------------------------------
# Hugging Face Free Inference API
# Create a free token (role: read): https://huggingface.co/settings/tokens
# ------------------------------------------------------------------
HF_FREE_API_TOKEN=your_hugging_face_token_here

# Automatic Speech Recognition model.
HF_MODEL=openai/whisper-large-v3

# Inference behaviour
# Base URL for hosted inference. The legacy api-inference.huggingface.co host
# was retired; hosted Whisper now lives behind the hf-inference provider.
HF_API_BASE_URL=https://router.huggingface.co/hf-inference/models
HF_REQUEST_TIMEOUT_MS=180000
HF_MAX_RETRIES=3
HF_RETRY_BASE_DELAY_MS=2000

# ------------------------------------------------------------------
# Uploads
# ------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
UPLOAD_TMP_DIR=./tmp

# ------------------------------------------------------------------
# Security
# ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=20

# ------------------------------------------------------------------
# Admin dashboard database (PostgreSQL)
# ------------------------------------------------------------------
# The dashboard is optional: with DB_ENABLED=false the transcription API keeps
# working and /api/admin/* replies 503 DATABASE_UNAVAILABLE.
DB_ENABLED=true

# Two ways to point at a server. DATABASE_URL wins when set.
#
# 1) Hosted provider (Neon, Supabase, RDS, Railway) — paste their URL:
# DATABASE_URL=postgresql://user:password@host:5432/inwebtools?sslmode=require
#
# 2) Local development — the discrete variables below.
PGHOST=localhost
PGPORT=5432
PGUSER=inwebtools_app
PGPASSWORD=change-me-before-running
PGDATABASE=inwebtools

# TLS. Off locally, REQUIRED by every managed provider.
PGSSL=false
# Leave true. Only set false for a provider using a self-signed chain, and
# never in production — it makes the connection interceptable.
PGSSL_REJECT_UNAUTHORIZED=true

# Connection pool. Postgres allows max_connections=100 by default, shared by
# every client, so one app instance must not try to own them all. Multiply
# PGPOOL_MAX by your instance count and keep it comfortably under that limit.
PGPOOL_MAX=10
PGPOOL_IDLE_MS=30000
PGPOOL_CONNECT_TIMEOUT_MS=10000

# ------------------------------------------------------------------
# Admin authentication (JWT)
# ------------------------------------------------------------------
# REQUIRED in production. Generate with:  openssl rand -base64 48
# A short or default value fails closed: login returns 503 AUTH_NOT_CONFIGURED.
JWT_SECRET=
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=inwebtools-admin

# Owner account created on first start, only if no admin exists yet.
# Change the password immediately after the first sign-in.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=
# Minimum length for an admin password. Enforced by the API, the dashboard's
# change-password form and the create-admin script, so raising it here raises
# it everywhere. Six is a low bar — raise it before production.
MIN_ADMIN_PASSWORD_LENGTH=6

ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW_MS=900000
# How long a visitor counts as "online" after their last request.
ADMIN_ONLINE_WINDOW_SECONDS=300

# ------------------------------------------------------------------
# Visitor geo lookup (optional, privacy sensitive)
# ------------------------------------------------------------------
# When true, public visitor IPs are sent to a third-party service to resolve
# country/city/ISP. Private and loopback addresses are always skipped.
GEO_LOOKUP_ENABLED=false
GEO_API_URL=http://ip-api.com/json
GEO_API_TIMEOUT_MS=3000
